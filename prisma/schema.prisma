// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/importing-client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SourceType {
  CAMERA
  VIDEO
  DEMO
}

enum VehicleClassification {
  NORMAL
  WARNING
  SPEEDING
}

enum DetectionEventType {
  DETECTED
  SPEED_WARNING
  SPEEDING
  SESSION_STARTED
  SESSION_STOPPED
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  name                 String?
  passwordHash         String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  monitoringSessions   MonitoringSession[]
  cameraConfigurations CameraConfiguration[]
  calibrationProfiles  CalibrationProfile[]
  speedThresholds      SpeedThreshold[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model MonitoringSession {
  id                String             @id @default(uuid())
  name              String
  description       String?
  status            SessionStatus      @default(DRAFT)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleDetections VehicleDetection[]
  trafficSummaries  TrafficSummary[]
  savedReports      SavedReport[]

  @@index([userId])
}

model CameraConfiguration {
  id                String     @id @default(uuid())
  name              String
  sourceType        SourceType @default(CAMERA)
  description       String?
  processingQuality String     @default("High")
  resolution        String?    @default("1920x1080")
  frameRate         Int?       @default(30)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalibrationProfile {
  id              String   @id @default(uuid())
  name            String
  knownDistance   Float
  distanceUnit    String   @default("m")
  calibrationData Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SpeedThreshold {
  id             String   @id @default(uuid())
  name           String
  normalMaximum  Float
  warningMaximum Float
  unit           String   @default("mph")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VehicleDetection {
  id             String                @id @default(uuid())
  sessionId      String
  session        MonitoringSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trackingId     String
  vehicleType    String                @default("Car")
  estimatedSpeed Float
  speedUnit      String                @default("mph")
  classification VehicleClassification @default(NORMAL)
  detectedAt     DateTime              @default(now())
  confidence     Float?
  boundingBox    Json?
  snapshotUrl    String?
  createdAt      DateTime              @default(now())
  events         DetectionEvent[]

  @@index([sessionId])
  @@index([trackingId])
  @@index([detectedAt])
}

model DetectionEvent {
  id          String             @id @default(uuid())
  detectionId String
  detection   VehicleDetection   @relation(fields: [detectionId], references: [id], onDelete: Cascade)
  eventType   DetectionEventType @default(DETECTED)
  createdAt   DateTime           @default(now())

  @@index([detectionId])
}

model TrafficSummary {
  id            String            @id @default(uuid())
  sessionId     String
  session       MonitoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vehicleCount  Int               @default(0)
  averageSpeed  Float             @default(0.0)
  maximumSpeed  Float             @default(0.0)
  speedingCount Int               @default(0)
  warningCount  Int               @default(0)
  normalCount   Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([sessionId])
}

model SavedReport {
  id         String            @id @default(uuid())
  name       String
  sessionId  String
  session    MonitoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reportType String            @default("SPEED_AUDIT")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([sessionId])
}
