# PostgreSQL only. Use a pooler URL appropriate for serverless production traffic.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speedsight?schema=public"
# Exact browser origin; used for same-origin write checks (no trailing path).
APP_URL="http://localhost:5173"
# Reserved/unused: random opaque tokens are hashed in PostgreSQL, not signed.
# Custom session authentication does not currently require AUTH_SECRET.
AUTH_SECRET=""
